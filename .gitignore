# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/

# Env / secrets - never commit real env
config/.env
*.env

# Data - generated and raw landings are reproducible, do not commit large data
data/raw/*
data/generated/*
data/staging/*
data/*.db
data/*.sqlite*
*.db
!data/**/.gitkeep

# Power BI temp
~$*.pbix
*.tmp

# Generated demo report outputs (reproduce via scripts/make_report.py)
reports/demo.html
reports/demo-screenshot.png
reports/web-login.png
reports/web-overview.png

# Frontend
frontend/node_modules/
frontend/dist/

# OS / editor
.DS_Store
.vscode/
.idea/
