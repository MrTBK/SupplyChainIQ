# Copy to config/.env (never commit config/.env). All secrets via env only.
# Warehouse (canonical: PostgreSQL 16 via Docker in Phase 5+; local dev may use DuckDB)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DB=supplychainiq
WAREHOUSE_USER=sci_loader
WAREHOUSE_PASSWORD=change_me

# Read-only analytics role for BI / ML / NL queries
ANALYTICS_USER=sci_analyst
ANALYTICS_PASSWORD=change_me

# Pipeline
DATA_SEED=42
GENERATOR_VERSION=v0.1.0
BATCH_ID=demo-0001
DQ_THRESHOLD=0.98
ENV=dev

# Web API (Phase 14+). All placeholders — generate real values for production.
SCI_SECRET_KEY=change-me-generate-random-32-bytes
SCI_ADMIN_USER=admin
SCI_ADMIN_PASSWORD=change-me
SCI_COOKIE_SECURE=0
SCI_CORS_ORIGINS=
SCI_TRUSTED_HOSTS=
SCI_SESSION_IDLE_MINUTES=30
SCI_SESSION_ABSOLUTE_HOURS=8
SCI_LOGIN_MAX_ATTEMPTS=5
SCI_LOGIN_WINDOW_S=300
